# Parley environment template.
# Copy this file to backend/.env and fill in the required values.
# Only .env.example is committed. Never commit a real .env or secret.

APP_NAME=Parley
DEBUG=True

# Required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave blank to make the backend fail fast at startup.
SECRET_KEY=

# Required. SQLite for local development.
DATABASE_URL=sqlite+aiosqlite:///./parley.db

FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173"]
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Replaying a rotated refresh token within this window is treated as a
# concurrent tab, not theft. Allowed range: 0-60 seconds.
REFRESH_REUSE_GRACE_SECONDS=10

# Set to True when served over HTTPS. False is allowed only when DEBUG=True.
COOKIE_SECURE=False

# In-process registration/login limiter. Per worker, not shared across processes.
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Maximum decoded ciphertext size in bytes (64 KiB).
MAX_CIPHERTEXT_BYTES=65536

# Frontend (only needed for a production build; the dev server uses the Vite proxy).
VITE_API_URL=/api
